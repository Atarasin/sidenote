        {
          "id": "c001-p0001",
          "text": "供给与需求是经济学最基本的两个概念。"
        },
        {
          "id": "c001-p0002",
          "text": "当供给曲线与需求曲线相交时，市场达到均衡。"
        },
        {
          "id": "c001-p0003",
          "text": "均衡价格 P0 由市场自发形成，无需外部干预。"
        }
      ]
